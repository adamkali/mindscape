{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Mindscape",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/tmp/mindscape-debug",
            "env": {},
            "args": ["-e", "development"],
            "preLaunchTask": "build-debug",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Launch Mindscape (Local)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/main.go",
            "env": {},
            "args": []
        },
        {
            "name": "Attach to Delve",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "port": 2345,
            "host": "localhost",
            "preLaunchTask": "dlv-serve",
            "showLog": true,
            "apiVersion": 2
        }
    ]
}
